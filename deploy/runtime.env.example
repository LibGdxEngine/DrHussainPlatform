# Bootstrap copies this to root-owned runtime.env (0600); fill all blank secrets.
# The controller supplies BACKEND_IMAGE and FRONTEND_IMAGE as immutable digests.
COMPOSE_PROJECT_NAME=mobser-test
EDGE_NETWORK=mobser_test_edge
EDGE_ALIAS=mobser-test-gateway
GATEWAY_PORT=18080
DB_NAME=mobser_test
DB_USER=mobser_test
DB_PASSWORD=
SECRET_KEY=
OTP_SECRET=
# Fernet keys (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# MEDIA_ENCRYPTION_KEYS is comma-separated: the first key encrypts, every key decrypts (rotation).
# Production refuses to start without both; losing them makes patient files and mailbox passwords unreadable.
MEDIA_ENCRYPTION_KEYS=
MAIL_CREDENTIALS_KEY=
# Mailbox settings may only point at public mail servers (the connection check would otherwise
# probe the hosting network); set to true only where the mail server is on the private network.
MAIL_ALLOW_PRIVATE_HOSTS=false
# Reading reports runs on the `ocr` Celery queue with these limits (seconds) and this PIL pixel cap.
RESULTS_READ_SOFT_TIME_LIMIT=900
RESULTS_READ_TIME_LIMIT=960
RESULTS_MAX_IMAGE_PIXELS=50000000
# Rows per page for list endpoints (clients may ask for up to 200 with ?page_size=).
API_PAGE_SIZE=50
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://test.example.com
ALLOWED_HOSTS=test.example.com,localhost,backend
CORS_ALLOWED_ORIGINS=https://test.example.com
CSRF_TRUSTED_ORIGINS=https://test.example.com
# Proxies between the internet and Django: the host's Caddy and this stack's gateway.
REST_NUM_PROXIES=2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Platform email (invitations, password resets). The test site discards it; a real deployment
# removes EMAIL_BACKEND (SMTP is then the default) and fills the EMAIL_* settings.
EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@test.example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
HIREAGENTS_BASE_URL=http://127.0.0.1:9
HIREAGENTS_AUTH_CHANNEL_ID=
HIREAGENTS_AUTH_API_KEY=
HIREAGENTS_SUPPORT_CHANNEL_ID=
HIREAGENTS_SUPPORT_API_KEY=
# Generate a distinct random value for each webhook key and signing secret.
HIREAGENTS_AUTH_WEBHOOK_API_KEY=
HIREAGENTS_AUTH_WEBHOOK_SIGNING_SECRET=
HIREAGENTS_SUPPORT_WEBHOOK_API_KEY=
HIREAGENTS_SUPPORT_WEBHOOK_SIGNING_SECRET=
